# Secrets and local data stores (never commit)
*.key
backend/encryption.key
backend/qdrant_db/
qdrant_db/
.env.*
!.env.example

# Evaluation: the throwaway index (own encryption key inside) is never committed.
# backend/evaluation/results/ IS committed on purpose: README numbers must trace to these files.
backend/qdrant_eval/

# Users, audit logs and secrets (never commit)
users.yaml
backend/users.yaml
logs/
backend/logs/

# Documentation: only README.md is published. Planning notes, the issue tracker, the threat model,
# resume drafts and other markdown stay on this machine.
*.md
!README.md

# Datasets are generated by the prepare scripts (fixed seed, public data), so they are not stored in git.
backend/eval_data/

# Evaluation runs that do not back a published number: dev-set tuning runs (rebuild with
# `python -m evaluation.tune_context`) and throwaway timing re-measurements.
# Everything else in backend/evaluation/results/ IS committed on purpose.
backend/evaluation/results/squad_dev__*/
backend/evaluation/results/*__latency/

# Human calibration: keep only the summary result, not the label sheet or the judge's hidden key.
backend/evaluation/calibration/*
!backend/evaluation/calibration/calibration_result.json

# Early artifacts that could not be reproduced: keep only the archived run the README cites.
docs/archive/*
!docs/archive/pre_alignment_ragas_2026-09-21.json

# Tool caches and logs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.log

# Local demo accounts (random passwords, local testing only)
demo_credentials.txt

# Personal study material (manual, exercises): local reference only
study/
