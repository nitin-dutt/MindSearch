# Copy this file to `.env` (git-ignored) and fill it in. docker compose reads .env automatically.

# Neo4j login. NEO4J_AUTH only applies when the database is first created; to change the password of an
# existing database run in Neo4j Browser:  ALTER CURRENT USER SET PASSWORD FROM 'old' TO 'new'
NEO4J_PASSWORD=change-me

# Signs login tokens. At least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MINDSEARCH_JWT_SECRET=

# AES-256 key that encrypts stored chunks (base64). LOSING IT MAKES STORED DATA UNREADABLE; back it up.
#   python backend/encryptor.py new-key
MINDSEARCH_DATA_KEY=

# Optional: serve a different model in vLLM (used for the independent evaluation judge)
# VLLM_MODEL=hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4
# VLLM_MAX_LEN=5120
