# Copy this file to `.env` (git-ignored) and fill it in. docker compose reads .env automatically.

# Neo4j login. NEO4J_AUTH only applies when the database is first created; to change the password of an
# existing database run in Neo4j Browser:  ALTER CURRENT USER SET PASSWORD FROM 'old' TO 'new'
NEO4J_PASSWORD=change-me

# Signs login tokens. At least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MINDSEARCH_JWT_SECRET=

# AES-256 key that encrypts stored chunks (base64). LOSING IT MAKES STORED DATA UNREADABLE; back it up.
#   python backend/encryptor.py new-key
MINDSEARCH_DATA_KEY=

# Optional: Grafana admin password (default 'admin'; the dashboard is only reachable from this machine).
# GRAFANA_ADMIN_PASSWORD=

# Knowledge-graph extraction model, used for every upload:
#   ollama (default): qwen2.5:14b-instruct through an Ollama server on the host (ollama pull qwen2.5:14b-instruct); CPU, slow.
#   vllm: the vLLM model that is already running; GPU, fast.
# If the chosen extractor cannot be reached, uploads are marked failed with that reason.
# KG_EXTRACTOR=vllm

# Generator (default since 2026-11-19): Qwen3.5-4B, 4-bit, CUDA graphs, at most 12 answers in progress, prompt enterprise_q35c, and the
# re-ranker on the GPU (API image about 12 GB). Nothing to set. Ready-made alternatives, loaded AFTER .env so the secrets stay here:
#   docker compose --env-file .env --env-file models/qwen25-7b.env -f docker-compose.yml -f docker-compose.eval.yml up -d   # previous stack
#   models/judge-llama31-8b.env                                                                                             # evaluation judge
# First start on a new machine: vLLM does not contact the internet by default (HF_HUB_OFFLINE=1). Set HF_HUB_OFFLINE=0 for that one start so the model
# is downloaded; a missing model otherwise stops vLLM's start-up (loud).
# HF_HUB_OFFLINE=0
# Single switches (see docker-compose.yml for all of them):
# RERANKER_DEVICE=cpu                    # re-ranker on the CPU (with TORCH_CUDA=0 a rebuild gives the 3 GB CPU-only API image)
# VLLM_ENFORCE_EAGER=1                   # no CUDA graphs (first answers 40-70% slower at 1-10 users, measured)
# VLLM_MAX_NUM_SEQS=12                   # cap on answers in progress; a hybrid model with CUDA graphs needs <= 47
# GENERATOR_THINKING=off                 # off | on (answers think, helper calls never) | none (a model without the option)
# PROMPT_PROFILE=enterprise_q35c         # the prompt tuned for Qwen3.5 on dev sets; enterprise for Qwen2.5
# VLLM_KV_CACHE_DTYPE=fp8                # PERF-02: measured and rejected (garbled answers); default auto = 16-bit
# VLLM_MTP_TOKENS=2                      # multi-token prediction: second fastest; does NOT fit together with CUDA graphs on 8 GB
# VLLM_GPU_MEMORY_UTILIZATION=0.85       # vLLM's share of the GPU; about 0.86 is the ceiling here (Windows keeps ~1.1 GiB)
# RERANKER_BACKEND=onnx                  # PERF-03: int8 ONNX on the CPU, measured and not adopted; needs WITH_ONNX=1 images
# KG_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ  # evaluation only: reuse the cached Qwen2.5 graph extractions
# KG_EXTRACT_MAX_TOKENS=2048            # reply budget of the vllm graph extractor (800 cut off most Qwen3.5 failures)

# Optional: CHAT_STRATEGY=agent lets the model plan its own searches (off by default; the API refuses to start if the model
# cannot make tool calls). RERANK_ONCE=0 restores the old double scoring, only for before/after load tests.

# Optional: every other model name, address and tuning knob (embedding / reranker model, Qdrant collection, history limits,
# upload size, ...) is defined with its default in backend/settings.py; set the variable named there to override it, e.g.
# GENERATOR_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16   # the model vLLM serves and the app asks for (VLLM_MODEL overrides only the server)
# EMBEDDING_MODEL=all-MiniLM-L6-v2                 # changing it needs a re-index: the vector size must match the stored data
